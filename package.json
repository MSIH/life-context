    "backfill:preferences": "node scripts/migrate-preferences.js",
    "places:cluster": "node scripts/cluster-places.js",
    "events:cluster": "node scripts/cluster-events.js",
    "schema:ingest": "node scripts/generate-ingest-schema.js",
    "check:boundary": "node scripts/check-boundary.js",
    "check:schema-literal": "node scripts/check-schema-literal.js",
    "check:handle-aliases": "node scripts/check-handle-aliases.js",
    "verify:schema-upgrade": "node scripts/verify-schema-upgrade.js",
    "geocode:build": "node scripts/build-places.js"
