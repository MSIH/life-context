  "main": "src/server.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/server.js",
    "dev": "node scripts/dev-server.js",
    "test": "node --test test/*.test.mjs",
    "test:connectors": "node scripts/test-connectors.mjs",
    "migrate": "node src/migrate.js",
    "import:contacts": "node src/contacts.js",
    "consolidate": "node src/consolidate.js",
    "backfill:relations": "node scripts/backfill-relations.js",
    "backfill:links": "node scripts/backfill-entity-links.js",
    "backfill:phones": "node scripts/backfill-phone-aliases.js",
    "backfill:display-names": "node scripts/backfill-display-names.js",
    "backfill:geo": "node scripts/backfill-place-labels.js",
    "directory:load": "node scripts/load-directory.js",
    "backfill:directory-proposals": "node scripts/backfill-directory-proposals.js",
    "backfill:pictured-proposals": "node scripts/backfill-pictured-proposals.js",
    "backfill:directory-attrs": "node scripts/backfill-directory-attrs.js",
    "backfill:name-prefix-links": "node scripts/backfill-name-prefix-links.js",
    "fix:name-prefix-confidence": "node scripts/fix-name-prefix-link-confidence.js",
    "fix:addresses": "node scripts/fix-duplicated-addresses.js",
    "backfill:handle-aliases": "node scripts/backfill-handle-aliases.js",
