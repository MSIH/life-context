# Where LifeContext is running and its shared secret (set to the same value as
# LIFECONTEXT_API_KEY in the core server's own .env — that's the literal env var name
# life-context reads). This hook only ever runs locally (SessionStart has no
# localhost:3000 reachability from a cloud session — see README.md's Out of Scope note),
# so LIFECONTEXT_URL is normally left at its default.
LIFECONTEXT_URL=http://localhost:3000
LIFECONTEXT_API_KEY=change-this-to-a-long-secure-token

# Optional: how long (ms) to wait for LifeContext to answer before giving up silently.
# Bounds an UNREACHABLE server (which fails in milliseconds regardless) — not a slow-but-working
# one: /api/search runs a query-planner LLM call and, on a text change, an embedding call, both
# real Ollama round-trips that can legitimately take several seconds (measured ~7s warm on this
# box). Default is 15000 (15s); raise it if your box's Ollama is routinely slower than that.
# PREFERENCES_TIMEOUT_MS=15000

# Optional: max preferences to fetch per session start. Defaults to 50 — LifeContext's own
# /api/search caps `limit` at 50, so this is already the highest value the server will accept;
# a value above 50 is clamped back down to it rather than sent verbatim.
# PREFERENCES_SEARCH_LIMIT=50
