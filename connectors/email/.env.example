# email connector — copy to .env (gitignored) and fill in. See README.md for the full setup,
# including why the account must be IMAP rather than POP (a POP profile has no Sent folder).

# Your LifeContext server and its API key (the same value the server itself uses).
LIFECONTEXT_URL=http://localhost:3000
LIFECONTEXT_API_KEY=change-this-to-a-long-secure-token

# Directory CONTAINING the Sent folder — the mail client's local directory for this account,
# not the folder itself. Find it via Account Settings -> Server Settings -> Local Directory.
EMAIL_STORE_PATH=

# Folder name within the store. Providers differ: Sent, "Sent Mail", "Sent Items".
EMAIL_SENT_FOLDER=Sent

# ISO date. Messages older than this are skipped. Leave unset for the last 24 months — unset
# deliberately does NOT mean "the whole archive", so a first run cannot pull decades by accident.
# EMAIL_SINCE=2024-01-01

# Resume marker (efficiency only — POST /api/v1/exists is what actually prevents duplicates)
# and the spool directory for payloads a failed run could not deliver.
# EMAIL_STATE_PATH=~/.life-context/email-state.json
# EMAIL_SPOOL_DIR=~/.life-context/email-spool

# Set to true (or pass --reingest) to heal already-ingested messages after a text_repr upgrade —
# see README.md's "Re-ingesting to apply a text_repr improvement". Leave unset for normal runs; a
# checked-in true here would make every routine run pay the full re-submit cost.
# EMAIL_REINGEST=true
