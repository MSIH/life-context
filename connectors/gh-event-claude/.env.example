# Where LifeContext is running and its shared secret (set to the same value as LIFECONTEXT_API_KEY
# in the core server's own .env — that's the literal env var name life-context reads). Must be
# reachable from wherever this hook runs — on Claude Code web that means a public/tunnel URL,
# not localhost.
LIFECONTEXT_URL=http://localhost:3000
LIFECONTEXT_API_KEY=change-this-to-a-long-secure-token

# Optional: override where failed ingests get spooled for retry on the next event
# (default: ~/.life-context/gh-event-spool.jsonl). Note: on ephemeral Claude Code web
# containers a spooled payload does not survive container reclaim.
# GH_EVENT_SPOOL_PATH=/home/you/.life-context/gh-event-spool.jsonl

# Optional: override the per-model USD-per-million-token pricing table used to cost a merged
# PR's transcript usage (#377). A JSON object keyed by the exact model id that appears in the
# transcript (e.g. "claude-opus-5"), each value {input, cacheWrite5m, cacheWrite1h, cacheRead,
# output} in USD per MTok. Cache writes take TWO rates because the premium is TTL-dependent:
# 1.25x input at the 5-minute TTL, 2x at the 1-hour TTL — an override supplying only one of
# them leaves the other undefined and that group's cost null. Replaces the built-in table
# wholesale when set — rates change over time and differ per model (Opus/Sonnet/Haiku), so this
# is never hardcoded without an override. A model not in the table still gets its usage
# recorded; only total_cost_usd stays null for it.
# GH_EVENT_MODEL_PRICING_JSON={"claude-opus-5":{"input":5.00,"cacheWrite5m":6.25,"cacheWrite1h":10.00,"cacheRead":0.50,"output":25.00}}
